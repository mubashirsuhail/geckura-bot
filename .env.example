# Discord Bot Token
# ⚠️ SECURITY: Paste your Discord bot token here. NEVER share or commit this file.
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Application ID
CLIENT_ID=your_discord_client_id_here

# Discord Server ID
GUILD_ID=your_discord_guild_id_here

# Gemini AI API Key (required for AI companion)
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Connection URI (optional, for production)
MONGODB_URI=mongodb://localhost:27017/geckura
